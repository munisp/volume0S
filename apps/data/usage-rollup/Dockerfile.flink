FROM apache/flink:1.20.2-scala_2.12-java11
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir apache-flink==1.20.2 \
    && rm -rf /opt/flink/opt/flink-python-*.jar \
    && ln -s /usr/bin/python3 /usr/bin/python
COPY --chown=flink:flink rollup_job.py /opt/volumeos/rollup_job.py
COPY --chown=flink:flink lib/ /opt/flink/lib/
USER flink
